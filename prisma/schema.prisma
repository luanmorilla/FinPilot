generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  perfil        PerfilFinanceiro?

  accounts      Account[]
  sessions      Session[]
  dividas       Divida[]
  metas         Meta[]
  cofrinhos     Cofrinho[]
  transacoes    Transacao[]
  alertas       Alerta[]
  notificacoes  Notificacao[]
  conquistas    Conquista[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PerfilFinanceiro {
  id                    String                @id @default(cuid())
  userId                String                @unique
  salario               Float
  frequenciaPagamento   FrequenciaPagamento
  diasPagamento         Int[]
  diaFixo               Int?
  onboardingCompleto    Boolean               @default(false)
  nivelFinanceiro       NivelFinanceiro       @default(BRONZE)
  pontos                Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("perfis_financeiros")
}

model Divida {
  id          String          @id @default(cuid())
  userId      String
  nome        String
  valor       Float
  vencimento  DateTime
  recorrente  Boolean         @default(false)
  paga        Boolean         @default(false)
  categoria   CategoriaDivida
  prioridade  Prioridade      @default(MEDIA)
  observacao  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dividas")
}

model Meta {
  id          String           @id @default(cuid())
  userId      String
  nome        String
  descricao   String?
  valorTotal  Float
  valorAtual  Float            @default(0)
  prazo       DateTime?
  emoji       String?          @default("🎯")
  concluida   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  depositos   DepositoMeta[]

  @@map("metas")
}

model DepositoMeta {
  id        String   @id @default(cuid())
  metaId    String
  valor     Float
  createdAt DateTime @default(now())

  meta Meta @relation(fields: [metaId], references: [id], onDelete: Cascade)

  @@map("depositos_meta")
}

model Cofrinho {
  id          String               @id @default(cuid())
  userId      String
  nome        String               @default("Meu Cofrinho")
  valorAtual  Float                @default(0)
  valorMeta   Float?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  depositos   DepositoCofrinho[]

  @@map("cofrinhos")
}

model DepositoCofrinho {
  id          String   @id @default(cuid())
  cofrinhoId  String
  valor       Float
  descricao   String?
  createdAt   DateTime @default(now())

  cofrinho Cofrinho @relation(fields: [cofrinhoId], references: [id], onDelete: Cascade)

  @@map("depositos_cofrinho")
}

model Transacao {
  id          String          @id @default(cuid())
  userId      String
  descricao   String
  valor       Float
  tipo        TipoTransacao
  categoria   String?
  data        DateTime        @default(now())
  antiImpulso Boolean         @default(false)
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transacoes")
}

model Alerta {
  id        String      @id @default(cuid())
  userId    String
  titulo    String
  mensagem  String
  tipo      TipoAlerta
  lido      Boolean     @default(false)
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alertas")
}

model Notificacao {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notificacoes")
}

model Conquista {
  id             String   @id @default(cuid())
  userId         String
  titulo         String
  descricao      String
  emoji          String
  conquistadaEm  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("conquistas")
}

enum FrequenciaPagamento {
  MENSAL
  QUINZENAL
  SEMANAL
  DUAS_VEZES_MES
  PERSONALIZADO
}

enum NivelFinanceiro {
  BRONZE
  PRATA
  OURO
  DIAMANTE
  MESTRE
}

enum CategoriaDivida {
  MORADIA
  ALIMENTACAO
  TRANSPORTE
  SAUDE
  EDUCACAO
  LAZER
  CARTAO_CREDITO
  EMPRESTIMO
  SERVICOS
  OUTROS
}

enum Prioridade {
  ALTA
  MEDIA
  BAIXA
}

enum TipoTransacao {
  RECEITA
  DESPESA
  TRANSFERENCIA
}

enum TipoAlerta {
  PAGAMENTO
  DIVIDA
  META
  COFRINHO
  RISCO
  CONQUISTA
  SISTEMA
}